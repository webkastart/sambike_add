generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Campaign {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  headline         String
  description      String
  imageUrl         String
  offerImageUrl    String?
  galleryImage1Url String?
  galleryImage2Url String?
  galleryImage3Url String?
  priceText        String
  ctaText          String   @default("Mám záujem")
  offerType        String
  phone            String
  email            String
  formEnabled      Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  leads            Lead[]
  metaAd            MetaAdCampaign?
  galleryItems      CampaignGalleryItem[]

  @@index([isActive])
}

model CampaignGalleryItem {
  id         String   @id @default(cuid())
  campaignId String
  mediaUrl   String   @map("imageUrl")
  mediaType  String   @default("IMAGE")
  sortOrder  Int
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sortOrder])
  @@map("CampaignGalleryImage")
}

model MetaAdCampaign {
  id                  String    @id @default(cuid())
  campaignId          String    @unique
  metaCampaignId      String?   @unique
  metaAdSetId         String?   @unique
  metaCreativeId      String?   @unique
  metaAdId            String?   @unique
  status              String    @default("DRAFT")
  effectiveStatus     String?
  platforms           String
  dailyBudgetCents    Int
  radiusKm            Int
  minAge              Int
  maxAge              Int
  primaryText         String
  adHeadline          String
  adDescription       String?
  destinationUrl      String
  startsAt            DateTime?
  endsAt              DateTime?
  spendCents          Int       @default(0)
  impressions         Int       @default(0)
  clicks              Int       @default(0)
  metaLeads           Int       @default(0)
  lastSyncedAt        DateTime?
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  campaign            Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Lead {
  id           String   @id @default(cuid())
  campaignId   String
  name         String
  phone        String
  email        String?
  interestType String
  note         String?
  consent      Boolean
  campaignSlug String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  landingPage  String?
  referrer     String?
  createdAt    DateTime @default(now())
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([createdAt])
}

model LeadNotificationRecipient {
  email     String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
