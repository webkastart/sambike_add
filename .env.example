DATABASE_URL="file:./dev.db"

# Povinné v produkcii. Bez hesla sa administrácia v produkcii neotvorí.
ADMIN_PASSWORD="zvolte-dlhe-jedinecne-heslo"
# Voliteľný samostatný podpisovací kľúč relácie; ak chýba, použije sa ADMIN_PASSWORD.
ADMIN_SESSION_SECRET="nahodny-dlhy-retazec"

# Resend – serverový API kľúč nikdy nezačínajte prefixom NEXT_PUBLIC_.
RESEND_API_KEY="re_vas_api_kluc"

# Na prvý test môžete použiť: SAMBIKE <onboarding@resend.dev>
# V produkcii použite adresu na doméne overenej v Resend, napr.:
RESEND_FROM_EMAIL="SAMBIKE <leady@send.sambike.sk>"
# Viac príjemcov oddeľte čiarkou. Odstránením adresy jej notifikácie vypnete.
LEAD_NOTIFICATION_EMAILS="sambike.snv@gmail.com,vas.email@example.com"

# Verejná adresa aplikácie pre odkaz na detail požiadavky v e-maile.
APP_URL="http://localhost:3000"

# Uploady kampaní. Lokálne nechajte "local"; v produkcii použite "r2".
CAMPAIGN_MEDIA_STORAGE="local"
R2_ACCOUNT_ID=""
R2_BUCKET_NAME="sambike-campaign-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_KEY_PREFIX="campaign-images"
# Voliteľné; ak chýba, použije sa https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""

# Voliteľný Meta Pixel. Bez tejto hodnoty landing page funguje bez Pixelu.
NEXT_PUBLIC_META_PIXEL_ID=""

# Meta Marketing API – všetky hodnoty zostávajú iba na serveri.
# Token systémového používateľa potrebuje minimálne oprávnenie ads_management.
META_ACCESS_TOKEN=""
META_APP_SECRET=""
META_AD_ACCOUNT_ID="act_123456789012345"
META_PAGE_ID="123456789012345"
# ID profesionálneho Instagram účtu pre Instagram placement; Facebook funguje aj bez neho.
META_INSTAGRAM_ACTOR_ID=""
# Verziu je možné posunúť bez zmeny kódu.
META_API_VERSION="v25.0"
# Predvolený stred okruhu je Spišská Nová Ves; týmito hodnotami ho môžete zmeniť.
META_DEFAULT_LATITUDE="48.9446"
META_DEFAULT_LONGITUDE="20.5615"
